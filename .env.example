# Copiá este archivo como ".env" y completá los valores.
# El archivo .env NO se sube a git (está en .gitignore).

# PIN para entrar a Administración y Cocina. Si lo dejás vacío, el acceso es libre.
VITE_ADMIN_PIN=1234

# Sólo si publicás la app en una subcarpeta (ej: https://sitio.com/bar/). Por defecto: /
# VITE_BASE=/bar/
